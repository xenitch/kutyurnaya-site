# Кутюрная — настройки для Apache на хостинге Timeweb
AddDefaultCharset utf-8
DirectoryIndex index.html

RewriteEngine On
# www → без www (протокол сохраняем; редирект на https включается в панели после выпуска сертификата)
RewriteCond %{HTTP_HOST} ^www\.kutyurnaya\.ru$ [NC]
RewriteRule ^(.*)$ %{REQUEST_SCHEME}://kutyurnaya.ru/$1 [R=301,L]

# Кэширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
